# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Dependency directories
vendor/

# Environment variables
.env

# Log files
*.log
game.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# OpenCode files (except agents which are version-controlled)
.opencode/*
!.opencode/agents/

# Build output
/pacman
/cmd/pacman/pacman
